-        firstBinding, bindingCount, pBuffers, pOffsets,
-        pSizes, pStrides);
+      // GeneralsX @bugfix Android port 30/07/2026 vkCmdBindVertexBuffers2
+      // is Vulkan 1.3 core / VK_EXT_extended_dynamic_state, null on
+      // Mali-G76 (Vulkan 1.1 only), tombstone-confirmed SIGSEGV in
+      // DxvkContext::updateVertexBufferBindings. See cmdBlitImage above
+      // for why this checks the resolved function pointer directly.
+      // Legacy vkCmdBindVertexBuffers has no per-draw stride/size
+      // parameters -- updateVertexBufferBindings (dxvk_context.cpp) never
+      // selects dynamic strides when this pointer is null, so pStrides is
+      // always null here in that case and the pipeline's own baked-in
+      // stride is used instead, same as sizes rely on the buffer's bound
+      // range.
+      if (likely(m_vkd->vkCmdBindVertexBuffers2 != nullptr)) {
+        m_vkd->vkCmdBindVertexBuffers2(getCmdBuffer(),
+          firstBinding, bindingCount, pBuffers, pOffsets,
+          pSizes, pStrides);
+        return;
+      }
+
+      m_vkd->vkCmdBindVertexBuffers(getCmdBuffer(),
+        firstBinding, bindingCount, pBuffers, pOffsets);
     }
     
