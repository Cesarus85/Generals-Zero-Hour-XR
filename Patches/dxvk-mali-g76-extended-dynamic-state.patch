     enabledFeatures.extGraphicsPipelineLibrary.graphicsPipelineLibrary =
@@ -1084,6 +1103,27 @@ namespace dxvk {
       m_deviceFeatures.extExtendedDynamicState3.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.extExtendedDynamicState3);
     }
 
+    // GeneralsX @bugfix Android port 30/07/2026 unlike most other
+    // Vulkan-1.3-era extensions handled in this fork, VK_EXT_extended_
+    // dynamic_state's functionality was NOT folded into a
+    // VkPhysicalDeviceVulkan13Features bool -- it remains its own
+    // standalone feature struct regardless of apiVersion (confirmed
+    // against the vendored Vulkan headers), so this is queried
+    // unconditionally, same as extExtendedDynamicState3 above.
+    if (m_deviceExtensions.supports(VK_EXT_EXTENDED_DYNAMIC_STATE_EXTENSION_NAME)) {
+      m_deviceFeatures.extExtendedDynamicState.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_FEATURES_EXT;
+      m_deviceFeatures.extExtendedDynamicState.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.extExtendedDynamicState);
+    }
+
+    // VK_EXT_shader_demote_to_helper_invocation, unlike the above, IS
+    // promoted into Vulkan 1.3 core (VkPhysicalDeviceVulkan13Features::
+    // shaderDemoteToHelperInvocation), so like khrDynamicRendering et al.
+    // it only needs a separate query on sub-1.3 adapters.
+    if (!hasVk13 && m_deviceExtensions.supports(VK_EXT_SHADER_DEMOTE_TO_HELPER_INVOCATION_EXTENSION_NAME)) {
+      m_deviceFeatures.extShaderDemoteToHelperInvocation.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DEMOTE_TO_HELPER_INVOCATION_FEATURES_EXT;
+      m_deviceFeatures.extShaderDemoteToHelperInvocation.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.extShaderDemoteToHelperInvocation);
+    }
+
     if (m_deviceExtensions.supports(VK_EXT_FRAGMENT_SHADER_INTERLOCK_EXTENSION_NAME)) {
       m_deviceFeatures.extFragmentShaderInterlock.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_INTERLOCK_FEATURES_EXT;
       m_deviceFeatures.extFragmentShaderInterlock.pNext = std::exchange(m_deviceFeatures.core.pNext, &m_deviceFeatures.extFragmentShaderInterlock);
@@ -1251,6 +1291,11 @@ namespace dxvk {
       &devExtensions.extDepthClipEnable,
       &devExtensions.extDepthBiasControl,
       &devExtensions.extExtendedDynamicState3,
+      // GeneralsX @bugfix Android port 30/07/2026 See DxvkDeviceExtensions::
+      // extExtendedDynamicState/extShaderDemoteToHelperInvocation
+      // (dxvk_extensions.h) for why this is needed on Mali-G76.
+      &devExtensions.extExtendedDynamicState,
+      &devExtensions.extShaderDemoteToHelperInvocation,
       &devExtensions.extFragmentShaderInterlock,
       &devExtensions.extFullScreenExclusive,
       &devExtensions.extGraphicsPipelineLibrary,
@@ -1408,6 +1453,30 @@ namespace dxvk {
       enabledFeatures.extExtendedDynamicState3.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.extExtendedDynamicState3);
     }
 
+    // GeneralsX @bugfix Android port 30/07/2026 see extExtendedDynamicState/
+    // extShaderDemoteToHelperInvocation query in queryDeviceFeatures() --
+    // same enable-chain pattern as extExtendedDynamicState3 above, placed
+    // here to avoid the reverse-apply conflicts that came from touching
+    // dxvk-vulkan11-adaptive.patch's own blocks. The extendedDynamicState
+    // bool itself was already set by DxvkAdapter::createDevice() (this is
+    // DxvkAdapter::initFeatureChain(), a static-ish helper with no
+    // m_deviceFeatures access), so only chains the struct in here,
+    // unconditionally like extExtendedDynamicState3 (see
+    // queryDeviceFeatures() for why this one has no hasVk13 gate).
+    if (devExtensions.extExtendedDynamicState) {
+      enabledFeatures.extExtendedDynamicState.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTENDED_DYNAMIC_STATE_FEATURES_EXT;
+      enabledFeatures.extExtendedDynamicState.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.extExtendedDynamicState);
+    }
+
+    // shaderDemoteToHelperInvocation IS a vk13 bool (unlike
+    // extendedDynamicState above), so reads enabledFeatures.vk13.
+    // shaderDemoteToHelperInvocation, which createDevice() populates.
+    if (!hasVk13 && devExtensions.extShaderDemoteToHelperInvocation) {
+      enabledFeatures.extShaderDemoteToHelperInvocation.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SHADER_DEMOTE_TO_HELPER_INVOCATION_FEATURES_EXT;
+      enabledFeatures.extShaderDemoteToHelperInvocation.shaderDemoteToHelperInvocation = enabledFeatures.vk13.shaderDemoteToHelperInvocation;
+      enabledFeatures.extShaderDemoteToHelperInvocation.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.extShaderDemoteToHelperInvocation);
+    }
+
     if (devExtensions.extFragmentShaderInterlock) {
       enabledFeatures.extFragmentShaderInterlock.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FRAGMENT_SHADER_INTERLOCK_FEATURES_EXT;
       enabledFeatures.extFragmentShaderInterlock.pNext = std::exchange(enabledFeatures.core.pNext, &enabledFeatures.extFragmentShaderInterlock);
diff --git a/src/dxvk/dxvk_device_info.h b/src/dxvk/dxvk_device_info.h
index e9741b3..4e61fdd 100644
--- a/src/dxvk/dxvk_device_info.h
+++ b/src/dxvk/dxvk_device_info.h
@@ -89,6 +89,20 @@ namespace dxvk {
     VkBool32                                                  nvxBinaryImport;
     VkBool32                                                  nvxImageViewHandle;
     VkBool32                                                  khrWin32KeyedMutex;
+    // GeneralsX @bugfix Android port 30/07/2026 Vulkan 1.3-promoted
+    // fallbacks, used when apiVersion < 1.3 (see DxvkAdapter::
+    // queryDeviceFeatures). VK_EXT_extended_dynamic_state and
+    // VK_EXT_shader_demote_to_helper_invocation are among the 1.3
+    // promotions, same as khrDynamicRendering/khrSynchronization2/
+    // khrMaintenance4 above, but were missing here -- meaning
+    // vk13.extendedDynamicState/shaderDemoteToHelperInvocation never
+    // got enabled on sub-1.3 devices even when the underlying EXT was
+    // genuinely supported, unconditionally breaking every graphics
+    // pipeline (VK_DYNAMIC_STATE_CULL_MODE etc. requires
+    // extendedDynamicState) and most fixed-function/alpha-test shaders
+    // (SPV_EXT_demote_to_helper_invocation) on Mali-G76 (Vulkan 1.1).
+    VkPhysicalDeviceExtendedDynamicStateFeaturesEXT           extExtendedDynamicState;
+    VkPhysicalDeviceShaderDemoteToHelperInvocationFeaturesEXT extShaderDemoteToHelperInvocation;
   };
 
 }
