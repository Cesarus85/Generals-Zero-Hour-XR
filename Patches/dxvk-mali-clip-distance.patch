diff --git a/src/dxso/dxso_options.h b/src/dxso/dxso_options.h
index 132b99a..1e390e5 100644
--- a/src/dxso/dxso_options.h
+++ b/src/dxso/dxso_options.h
@@ -47,6 +47,17 @@ namespace dxvk {
     /// that expect a different depth test range, which was typically a D3D8 quirk on
     /// early NVIDIA hardware.
     int32_t drefScaling = 0;
+
+    /// GeneralsX @bugfix Android port 30/07/2026 Whether the device actually
+    /// supports VkPhysicalDeviceFeatures::shaderClipDistance. D3D9's vertex
+    /// shader output signature always reserves clip-plane output slots
+    /// regardless of whether a given shader/game uses them, so emitVsInit()
+    /// unconditionally declared SPIR-V's ClipDistance capability -- true on
+    /// every desktop GPU and Adreno, but not universal on mobile (Mali G57:
+    /// VUID-VkShaderModuleCreateInfo-pCode-08740, "Capability ClipDistance
+    /// was declared, but ... shaderClipDistance" is required). Gate emission
+    /// on this instead of assuming it's always available.
+    bool supportsClipDistance;
   };
 
 }
