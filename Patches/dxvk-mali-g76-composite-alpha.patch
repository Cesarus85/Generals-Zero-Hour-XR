+  // GeneralsX @bugfix Android port 30/07/2026 swap chain creation
+  // hardcoded VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR unconditionally. Real-
+  // device testing (Redmi Note 8 Pro / Mali-G76 MC4) found a surface
+  // that only reports VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR as supported
+  // (validation: VUID-VkSwapchainCreateInfoKHR-compositeAlpha-01280),
+  // so vkCreateSwapchainKHR failed and left the swapchain null, crashing
+  // the very next time the render loop tried to use it. Picks OPAQUE
+  // when supported (the common desktop case) and otherwise the first
+  // bit the surface actually reports, same "ask the driver, don't
+  // assume" approach as pickSurfaceFormat/pickPresentMode above.
+  VkCompositeAlphaFlagBitsKHR Presenter::pickCompositeAlpha(
+          VkCompositeAlphaFlagsKHR  supported) {
+    if (supported & VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR)
+      return VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+
+    static const std::array<VkCompositeAlphaFlagBitsKHR, 3> fallbacks = {
+      VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR,
+      VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR,
+      VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR,
+    };
+
+    for (auto flag : fallbacks) {
+      if (supported & flag)
+        return flag;
+    }
+
+    return VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+  }
+
