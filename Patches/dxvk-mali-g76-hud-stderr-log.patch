@@ -462,6 +464,9 @@ namespace dxvk::hud {
     uint64_t m_graphicsLibraries  = 0;
     uint64_t m_computePipelines   = 0;
 
+    dxvk::high_resolution_clock::time_point m_lastLogTime
+      = dxvk::high_resolution_clock::now();
+
   };
 
 
