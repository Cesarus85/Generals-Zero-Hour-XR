+      // GeneralsX @bugfix Android port 30/07/2026 These six were declared in
+      // DxvkDeviceExtensions (dxvk_extensions.h) as the sub-1.2/1.3 KHR/EXT
+      // fallbacks for Mali/Unisoc/PowerVR adapters, and queryDeviceFeatures()
+      // already queries their feature bits directly -- but they were never
+      // added to THIS list, which is what enableExtensions() walks to decide
+      // which extensions actually get requested from vkCreateDevice and
+      // chained into its pNext. Without being here, their DxvkExt::m_revision
+      // never leaves 0, so vkCreateDevice never enabled them even though the
+      // feature bit was reported as supported -- e.g. Mali-G76 MC4 (Redmi
+      // Note 8 Pro) reported timelineSemaphore=1 in the diagnostic log, yet
+      // DxvkSubmissionQueue's vkCreateSemaphore(VK_SEMAPHORE_TYPE_TIMELINE)
+      // failed VUID-VkSemaphoreTypeCreateInfo-timelineSemaphore-03252 because
+      // the feature was never actually enabled at device-creation time.
+      &devExtensions.extHostQueryReset,
+      &devExtensions.khrDynamicRendering,
+      &devExtensions.khrMaintenance4,
+      &devExtensions.khrSynchronization2,
+      &devExtensions.khrTimelineSemaphore,
+      &devExtensions.khrVulkanMemoryModel,
       &devExtensions.extHdrMetadata,
       &devExtensions.extLineRasterization,
       &devExtensions.extMemoryBudget,
